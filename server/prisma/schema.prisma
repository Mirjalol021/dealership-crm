// Dealership CRM V2 — Prisma schema
// Phase 1 (Foundation) + Phase 2 (Leads).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  SUPER_ADMIN
  HEAD_OF_SALES
  SALES_MANAGER
  CALL_CENTER
  SERVICE_STAFF
  FINANCE
}

enum Language {
  uz
  ru
  en
}

// Lead distribution mode (§6)
enum LeadDistributionMode {
  MANAGER_SELF_PICK
  CALL_CENTER_QUALIFICATION
}

// Pipeline status (§11)
enum PipelineStatus {
  NEW
  WORKING
  VISIT_PLANNED
  VISITED_TEST_DRIVE
  SOLD
  LOST
}

// Lead result (§12)
enum LeadResult {
  NO_ANSWER
  CLIENT_BUSY
  WRONG_NUMBER
  INFO_GIVEN_VISIT_EXPECTED
  INFO_GIVEN_THINKING
  INTERESTED
  NOT_INTERESTED
  LEFT_INFO_BY_MISTAKE
  ANOTHER_REGION
  VISIT_PLANNED
  TEST_DRIVE_COMPLETED
  SOLD
}

enum LeadPriority {
  NORMAL
  PRIORITY
}

// Lead sources (§8)
enum LeadSource {
  META
  TELEGRAM
  INSTAGRAM_ORGANIC
  TELEGRAM_ORGANIC
  WALK_IN
  PHONE_CALL
  REFERRAL
  EXISTING_CUSTOMER
  MANUAL
  OTHER
}

// Appointment status (§24)
enum AppointmentStatus {
  PLANNED
  ARRIVED
  NO_SHOW
}

// Assignment type (§22)
enum AssignmentType {
  SELF_PICK
  CALL_CENTER
  HEAD_OF_SALES
  SUPER_ADMIN
  REASSIGNMENT
}

// Activity event type (§21)
enum ActivityEvent {
  LEAD_CREATED
  LEAD_ENTERED_POOL
  LEAD_TAKEN
  LEAD_ASSIGNED
  LEAD_REASSIGNED
  RESULT_UPDATED
  FOLLOW_UP_SCHEDULED
  PIPELINE_CHANGED
  COMMENT_ADDED
  VISIT_PLANNED
  TEST_DRIVE_COMPLETED
  SOLD
  LOST
}

// Phase 3 (§27-§34)
enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum PaymentType {
  CASH
  CREDIT
  OTHER
}

enum PaymentMethod {
  LLC_ACCOUNT
  CASH
  CARD
}

enum BonusStatus {
  EXPECTED
  CONFIRMED
  PAID
}

enum BonusType {
  TONIROVKA
  POLIK
  REGISTRATION
  FUEL
  GIFT
  OTHER
}

// Phase 4 (§34-§40)
enum ExpenseType {
  FIXED
  VARIABLE
}

enum ExpenseStatus {
  PENDING
  PAID
}

// ---------- CORE ----------

model Brand {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  logoUrl   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealershipLinks DealershipBrand[]
  userLinks       UserBrandAccess[]
  leads           Lead[]
  inventoryVehicles InventoryVehicle[]
  soldCars        SoldCar[]
  expenses        Expense[]
  kpiBonuses      KpiBonus[]

  @@index([active, sortOrder])
}

model Dealership {
  id             String   @id @default(cuid())
  dealershipName String
  cityRegion     String
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brandLinks DealershipBrand[]
  userLinks  UserDealershipAccess[]
  leads      Lead[]
  appointments Appointment[]
  inventoryVehicles InventoryVehicle[]
  soldCars   SoldCar[]
  expenses   Expense[]
  kpiBonuses KpiBonus[]

  @@index([active])
}

model DealershipBrand {
  dealershipId String
  brandId      String
  createdAt    DateTime @default(now())

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  brand      Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([dealershipId, brandId])
  @@index([brandId])
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String?
  passwordHash      String
  role              Role
  preferredLanguage Language @default(uz)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dealershipAccess UserDealershipAccess[]
  brandAccess      UserBrandAccess[]
  sessions         Session[]

  assignedLeads   Lead[]            @relation("LeadAssignee")
  leadComments    LeadComment[]
  appointments    Appointment[]     @relation("AppointmentManager")
  reservations    VehicleReservation[] @relation("ReservationManager")
  soldCars        SoldCar[]         @relation("SoldCarManager")

  @@index([role, active])
}

model UserDealershipAccess {
  userId       String
  dealershipId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@id([userId, dealershipId])
  @@index([dealershipId])
}

model UserBrandAccess {
  userId    String
  brandId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
  @@index([brandId])
}

// ---------- AUTH ----------

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- APP SETTINGS ----------

// Single-row application settings (lead distribution mode, etc.)
model AppSettings {
  id                   String               @id @default("singleton")
  leadDistributionMode LeadDistributionMode @default(MANAGER_SELF_PICK)
  updatedAt            DateTime             @updatedAt
}

// ---------- LEADS ----------

model Customer {
  id            String   @id @default(cuid())
  name          String?
  primaryPhone  String   // normalized
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  phones LeadPhone[]
  leads  Lead[]
  reservations VehicleReservation[]
  soldCars SoldCar[]

  @@index([primaryPhone])
}

model LeadPhone {
  id        String   @id @default(cuid())
  customerId String
  phone     String   // normalized
  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([customerId])
}

model Lead {
  id            String  @id @default(cuid())
  customerId    String
  dealershipId  String
  brandId       String
  modelInterest String?
  source        LeadSource
  campaign      String?
  formId        String?
  externalLeadId String?

  // Ownership (§10)
  assignedUserId String?
  assignedAt     DateTime?
  priority       LeadPriority @default(NORMAL)

  // Sales state
  pipelineStatus  PipelineStatus @default(NEW)
  lastResult      LeadResult?
  nextFollowUpAt  DateTime?
  expectedVisitAt DateTime?

  // Timestamps (§10, §74)
  createdAt      DateTime  @default(now())
  firstContactAt DateTime?
  lastContactAt  DateTime?
  visitedAt      DateTime?
  soldAt         DateTime?
  lostAt         DateTime?

  updatedAt DateTime @updatedAt

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealership    Dealership        @relation(fields: [dealershipId], references: [id])
  brand         Brand             @relation(fields: [brandId], references: [id])
  assignedUser  User?             @relation("LeadAssignee", fields: [assignedUserId], references: [id])

  comments      LeadComment[]
  attempts      LeadContactAttempt[]
  activities    LeadActivity[]
  assignments   LeadAssignment[]
  appointments  Appointment[]
  formAnswers   LeadFormAnswer[]
  reservations  VehicleReservation[]

  @@index([pipelineStatus])
  @@index([assignedUserId])
  @@index([dealershipId])
  @@index([brandId])
  @@index([nextFollowUpAt])
  @@index([source])
  @@index([createdAt])
}

model LeadComment {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
}

model LeadContactAttempt {
  id        String     @id @default(cuid())
  leadId    String
  attemptNo Int
  result    LeadResult
  createdAt DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadActivity {
  id       String        @id @default(cuid())
  leadId   String
  userId   String?
  event    ActivityEvent
  oldValue String?
  newValue String?
  createdAt DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadAssignment {
  id             String         @id @default(cuid())
  leadId         String
  fromUserId     String?
  toUserId       String?
  assignedById   String?
  assignmentType AssignmentType
  createdAt      DateTime       @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Appointment {
  id           String            @id @default(cuid())
  leadId       String
  customerId   String
  dealershipId String
  brandId      String
  managerId    String?
  date         DateTime
  time         String? // "15:00" optional (§24)
  status       AppointmentStatus @default(PLANNED)
  note         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealership Dealership @relation(fields: [dealershipId], references: [id])
  manager    User?      @relation("AppointmentManager", fields: [managerId], references: [id])

  @@index([leadId])
  @@index([date])
}

// Form configuration (§61) and dynamic answers (§60)
model ExternalLeadForm {
  id           String     @id @default(cuid())
  source       LeadSource
  formId       String
  formName     String
  brandId      String?
  dealershipId String?
  active       Boolean    @default(true)
  fieldMapping Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([source, formId])
}

model LeadFormAnswer {
  id                    String   @id @default(cuid())
  leadId                String
  externalFieldKey      String
  questionLabelSnapshot String
  answer                String
  displayOrder          Int      @default(0)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ---------- VEHICLE SALES (§27-§34) ----------

model InventoryVehicle {
  id           String        @id @default(cuid())
  dealershipId String
  brandId      String
  model        String
  trim         String?
  color        String?
  vin          String        @unique
  arrivalDate  DateTime      @default(now())
  sellingPrice Decimal?      @db.Decimal(14, 2)
  status       VehicleStatus @default(AVAILABLE)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  dealership   Dealership          @relation(fields: [dealershipId], references: [id])
  brand        Brand               @relation(fields: [brandId], references: [id])
  reservations VehicleReservation[]
  soldCar      SoldCar?

  @@index([status])
  @@index([dealershipId])
  @@index([brandId])
}

model VehicleReservation {
  id                    String      @id @default(cuid())
  vehicleId             String
  customerId            String
  phone                 String?
  leadId                String?
  salesManagerId        String?
  reservationDate       DateTime    @default(now())
  depositAmount         Decimal     @db.Decimal(14, 2)
  depositPaymentMethod  PaymentMethod?
  expirationDate        DateTime?
  comment               String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  vehicle      InventoryVehicle @relation(fields: [vehicleId], references: [id])
  customer     Customer         @relation(fields: [customerId], references: [id])
  lead         Lead?            @relation(fields: [leadId], references: [id])
  salesManager User?            @relation("ReservationManager", fields: [salesManagerId], references: [id])

  @@index([vehicleId])
  @@index([customerId])
}

model SoldCar {
  id                   String      @id @default(cuid())
  saleDate             DateTime    @default(now())
  dealershipId         String
  brandId              String
  model                String
  vin                  String      @unique
  customerId           String
  phone                String?
  salesManagerId       String?
  salePrice            Decimal     @db.Decimal(14, 2)
  paymentType          PaymentType
  financeProductText   String?
  manualMargin         Decimal     @db.Decimal(14, 2) // actual deal margin (§30)
  discountedSale       Boolean     @default(false)
  discountAmount       Decimal?    @db.Decimal(14, 2)
  discountComment      String?
  vehicleId            String?     @unique
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  dealership      Dealership            @relation(fields: [dealershipId], references: [id])
  brand           Brand                 @relation(fields: [brandId], references: [id])
  customer        Customer              @relation(fields: [customerId], references: [id])
  salesManager    User?                 @relation("SoldCarManager", fields: [salesManagerId], references: [id])
  vehicle         InventoryVehicle?     @relation(fields: [vehicleId], references: [id])
  customerBonuses VehicleCustomerBonus[]
  vinBonuses      VinDistributorBonus[]

  @@index([saleDate])
  @@index([dealershipId])
  @@index([brandId])
}

model VehicleCustomerBonus {
  id        String      @id @default(cuid())
  soldCarId String
  bonusType BonusType
  amount    Decimal     @db.Decimal(14, 2)
  date      DateTime    @default(now())
  paidFrom  PaymentMethod
  comment   String?
  createdAt DateTime    @default(now())

  soldCar SoldCar @relation(fields: [soldCarId], references: [id], onDelete: Cascade)

  @@index([soldCarId])
}

model VinDistributorBonus {
  id              String      @id @default(cuid())
  soldCarId       String
  amount          Decimal     @db.Decimal(14, 2)
  accountingMonth String      // "2026-09"
  status          BonusStatus @default(EXPECTED)
  receivedDate    DateTime?
  receivedVia     PaymentMethod?
  comment         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  soldCar SoldCar @relation(fields: [soldCarId], references: [id], onDelete: Cascade)

  @@index([soldCarId])
  @@index([status])
}

// ---------- FINANCE (§34, §36, §40) ----------

// Distributor KPI bonus — separate from VIN bonus (§34).
model KpiBonus {
  id           String       @id @default(cuid())
  month        String       // "2026-09"
  dealershipId String?
  brandId      String
  amount       Decimal      @db.Decimal(14, 2)
  status       BonusStatus  @default(EXPECTED)
  receivedDate DateTime?
  receivedVia  PaymentMethod?
  comment      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  dealership Dealership? @relation(fields: [dealershipId], references: [id])
  brand      Brand       @relation(fields: [brandId], references: [id])

  @@index([month])
  @@index([status])
}

// Expense entry (§36-§38). accountingMonth vs paymentDate is critical.
model Expense {
  id              String        @id @default(cuid())
  accountingMonth String        // "2026-08" — which month it BELONGS to
  paymentDate     DateTime?     // when money ACTUALLY moved (null while Pending)
  dealershipId    String?
  brandId         String?       // null = Corporate
  category        String        // free label; categories seeded
  expenseType     ExpenseType
  amount          Decimal       @db.Decimal(14, 2)
  paymentMethod   PaymentMethod?
  status          ExpenseStatus @default(PENDING)
  comment         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  dealership Dealership? @relation(fields: [dealershipId], references: [id])
  brand      Brand?      @relation(fields: [brandId], references: [id])

  @@index([accountingMonth])
  @@index([paymentDate])
  @@index([dealershipId])
}

// Configurable finance tax settings (§40). Single row.
model FinanceSettings {
  id          String   @id @default("singleton")
  taxName     String   @default("VAT")
  taxRate     Decimal  @default(12) @db.Decimal(6, 2) // percent
  taxBase     String   @default("VEHICLE_MARGIN")
  marginIsVatInclusive Boolean @default(true) // VAT-inclusive margin?
  updatedAt   DateTime @updatedAt
}

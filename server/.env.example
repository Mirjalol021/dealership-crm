# Copy to .env and adjust. Do NOT commit real .env.

DATABASE_URL="postgresql://crm_app:crm_app_dev_password@127.0.0.1:5432/dealership_crm?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Session cookie — MUST be a long random string (>= 32 chars) in production.
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"
SESSION_TTL_HOURS=24

# Allowed CORS origins in production (comma-separated). Ignored in development.
CORS_ORIGINS="https://crm.example.com"

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Default language for new users: uz | ru | en
DEFAULT_LANGUAGE=uz
